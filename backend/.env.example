# Fill these on the host (Render/Railway/etc). Do not commit real secrets.
SITE_PASSWORD=CHANGE_ME_SITE_PASSWORD
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY
SESSION_SECRET=

# Main analysis model (OpenRouter) — only when router escalates
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Cheap front-agent (router) + Grok power escalate (counts against daily hard cap)
AI_ROUTER_MODEL=meta-llama/llama-3.2-3b-instruct
AI_GROK_MODEL=x-ai/grok-4.20

# Hard daily OpenRouter spend CAP in EUR (ceiling — not a burn target)
AI_DAILY_BUDGET_EUR=10
AI_BUDGET_RESERVE_EUR=0
# Soft band ~70–80% blocks main/grok; hard band 95–100% blocks all LLM
AI_BUDGET_SOFT_RATIO=0.75
AI_BUDGET_HARD_RATIO=0.95
AI_USD_EUR_RATE=0.92
AI_BUDGET_TZ=Europe/Berlin

# Paid AI entitlement for site-password sessions until Stripe (paid|free)
AI_ENTITLEMENT=paid

# Proactive TTS: opt_in (default off until user enables) | on | off
AI_PROACTIVE_TTS=opt_in

# browser-use worker (Python + headless Chrome)
BROWSER_USE_ENABLED=true
BROWSER_USE_ALLOW_ORIGIN=http://127.0.0.1:8787
BROWSER_USE_RATE_LIMIT_PER_MIN=6
AI_BROWSER_USE_MIN_REMAINING_EUR=3
CHROME_PATH=/usr/local/bin/google-chrome

# Mechanized world news (no LLM)
NEWS_RSS_URL=https://feeds.bbci.co.uk/news/world/rss.xml

PORT=8787
HOST=0.0.0.0

OPENROUTER_HTTP_REFERER=https://your-app.onrender.com
OPENROUTER_APP_TITLE=Holographic Dashboard

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60
MAX_PROMPT_CHARS=8000
MAX_SYSTEM_CHARS=2000
MAX_TOKENS=1024

MEMORY_DB_PATH=/agent/backend/data/memory.sqlite
VERIFICATION_THRESHOLD=0.72
COOKIE_SECURE=false

# Enable /api/ai/test/* hooks for local test passes only
# AI_TEST_HOOKS=1
