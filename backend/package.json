{
  "name": "holographic-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Secure OpenRouter proxy for the holographic dashboard (synthesis/ranking only)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:atlas": "node --test src/services/atlas*.test.js",
    "postinstall": "bash scripts/install-browser-use-runtime.sh",
    "install:browser-use": "bash scripts/install-browser-use-runtime.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  }
}
