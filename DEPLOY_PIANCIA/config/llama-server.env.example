# Copia questo file come llama-server.env e adatta i percorsi Windows.
# Non committare percorsi con dati personali.

# --- Percorsi (Windows) ---
# Esempio: C:\Models\Qwen3.6-35B-A3B-Q4_K_M.gguf
LLAMA_MODEL=C:\Models\Qwen3.6-35B-A3B-Q4_K_M.gguf
# Esempio: C:\Tools\llama.cpp\build\bin\Release\llama-server.exe
LLAMA_SERVER_BIN=C:\Tools\llama.cpp\build\bin\Release\llama-server.exe

# --- Bind locale (solo macchina, non esporre in LAN senza auth) ---
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# --- GPU / MoE split per RTX 5070 12 GB + 32 GB RAM ---
# Offload di tutti i layer possibili su GPU; gli expert MoE vanno su CPU.
N_GPU_LAYERS=99
# Numero di layer MoE i cui expert restano in RAM di sistema (tipico 36-40 su questo modello).
N_CPU_MOE=40

# --- Contesto voce: corto = meno KV cache, più spazio VRAM, latenza migliore ---
# Usa 2048 per turni corti, 4096 default plancia, 8192 se serve memoria conversazione più lunga.
CTX_SIZE=4096

# --- Generazione (voce) ---
# Risposte brevi: meno token = TTS più rapido.
N_PREDICT=256
TEMPERATURE=0.6
TOP_P=0.95
REPEAT_PENALTY=1.1

# --- Thread CPU per expert offload ---
# Lascia 2-4 core liberi per OS / STT / TTS. Su Ryzen/Intel 8+ core tipico: 6-12.
THREADS=8
THREADS_BATCH=8

# --- Thinking OFF (Qwen3.x) ---
# 1 = disabilita il reasoning esteso (obbligatorio per latenza voce).
DISABLE_THINKING=1

# --- Sicurezza ---
# Chiave opzionale per /v1 (se abilitata nel server). Lascia vuoto per solo localhost.
API_KEY=

# --- NO MTP / speculative ---
# Non impostare DRAFT_MODEL. Lo script di avvio non abilita speculative/MTP.
# DRAFT_MODEL=
