# Copia come llama-router.env e adatta i path Windows.

# Qwen3-8B Instruct Q4_K_M — router voce (full GPU, niente MoE offload)
LLAMA_MODEL=C:\Models\Qwen3-8B-Q4_K_M.gguf
LLAMA_SERVER_BIN=C:\Tools\llama.cpp\build\bin\Release\llama-server.exe

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8070

# Full GPU — modello denso 8B Q4 ~5-6 GB VRAM
N_GPU_LAYERS=99
# Non impostare N_CPU_MOE sul router (non è MoE / non serve)

CTX_SIZE=2048
N_PREDICT=96
TEMPERATURE=0.4
TOP_P=0.9
REPEAT_PENALTY=1.1

THREADS=8
THREADS_BATCH=8

DISABLE_THINKING=1
API_KEY=

# Vietato MTP
# DRAFT_MODEL=
