# Local PC / LAN only — copy into backend/.env
# This stack is fully separate from Render: no shared secrets, no API link, no proxy.
SITE_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
AI_ENTITLEMENT=paid

PORT=8787
HOST=127.0.0.1
COOKIE_SECURE=false

# Brain on THIS machine's disk only.
# Example: D:\AtlasMemory or /home/emilio/AtlasMemory
# Default relative to backend/: data/agentq-memory
ATLAS_MEMORY_DIR=data/agentq-memory

MEMORY_DB_PATH=data/memory.sqlite
BROWSER_USE_ALLOW_ORIGIN=http://127.0.0.1:8787

# --- LM Studio on desktop Bionic (Ubuntu), LAN hostname — NOT on the cloud server ---
# Prefer mDNS / LAN DNS names. Do not put a server-loopback URL here.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_HOSTS=bionic.local,bionic
# Browser su Bionic apre localhost:23000 → stessa porta in LAN via hostname.
LOCAL_LLM_PORT=23000
# Optional full override:
# LOCAL_LLM_BASE_URL=http://bionic.local:23000/v1

# Exact LM Studio model id (OpenAI-compatible /v1). Quant on disk: Q4_K.
LOCAL_LLM_MODEL=Huihui-Qwen3.6-35B-A3B-Claude-4.7-Opus-abliterated-MTP-GGUF
LOCAL_LLM_API_KEY=lm-studio
LOCAL_LLM_TIMEOUT_MS=120000

# Optional OpenRouter only for cloud STT/TTS/fallback (still not linked to Render)
# OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
OPENROUTER_APP_TITLE=Atlas Plancia Locale
