# Copy values into backend/.env for local PC (not Render).
SITE_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
AI_ENTITLEMENT=paid

PORT=8787
HOST=127.0.0.1
COOKIE_SECURE=false

# Absolute or relative path on THIS PC — never a Render ephemeral path.
# Example Windows: D:\AtlasMemory
# Default relative to backend/: data/agentq-memory
ATLAS_MEMORY_DIR=data/agentq-memory

MEMORY_DB_PATH=data/memory.sqlite
BROWSER_USE_ALLOW_ORIGIN=http://127.0.0.1:8787

# Optional OpenRouter if you still call cloud models from the PC
# OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
OPENROUTER_APP_TITLE=Atlas Plancia Locale
