# Esempio ufficiale da sentient-engineering/agent-q (.env.example)
# Copia questo file in `.env` e compila le chiavi reali.
# Il modello deve essere gpt-4o-2024-08-06: Agent Q dipende dall'output strutturato di OpenAI.

MODEL_NAME="gpt-4o-2024-08-06"

LITELLM_LOG="ERROR"

OPENAI_API_KEY=""

# Puoi omettere Langfuse. Nel README ufficiale: per disabilitare il tracing
# importa `openai` direttamente invece di wrapper di tracing, se presenti.
LANGFUSE_SECRET_KEY="sk-lf-"
LANGFUSE_PUBLIC_KEY="pk-lf-"
LANGFUSE_HOST="https://cloud.langfuse.com"

# Opzionale: CDP Chrome già avviato (vedi README ufficiale --remote-debugging-port=9222)
# CDP_ENDPOINT="http://localhost:9222"

# Obiettivo di default per una run locale di smoke-test
AGENTQ_OBJECTIVE="Apri example.com e riassumi il titolo della pagina"
AGENTQ_MODE="orchestrator"
# AGENTQ_MODE può essere: orchestrator | mcts
